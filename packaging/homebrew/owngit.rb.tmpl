{{- end}}
{{- if .Tap}}
# Tap: {{.Tap}}
{{- end}}
class Owngit < Formula
  desc "Private Git storage and browser dashboard on your own computer"
  homepage "{{ruby .Homepage}}"
  version "{{ruby .Version}}"
  license "MIT"

  depends_on "git"

  on_macos do
    on_arm do
      url "{{ruby .BaseURL}}/{{ruby .DarwinArm64.Name}}"
      sha256 "{{ruby .DarwinArm64.SHA256}}"
    end
  end

  on_linux do
    on_intel do
      url "{{ruby .BaseURL}}/{{ruby .LinuxAMD64.Name}}"
      sha256 "{{ruby .LinuxAMD64.SHA256}}"
    end
    on_arm do
      url "{{ruby .BaseURL}}/{{ruby .LinuxARM64.Name}}"
      sha256 "{{ruby .LinuxARM64.SHA256}}"
    end
  end

  def install
    bin.install "owngit"
    prefix.install "LICENSE"
    prefix.install "THIRD_PARTY_NOTICES"
  end

  # The first start writes the setup file path to this log.
  service do
    run [opt_bin/"owngit", "serve", "-no-open"]
    keep_alive true
    log_path var/"log/owngit.log"
    error_log_path var/"log/owngit.log"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/owngit version")
  end
end
