# Maintainer: {{.AURMaintainer}}
# Generated by tools/release from the artifact manifest. Do not edit by hand.
{{- if .AURUnready}}
# UNREADY: {{.AURUnready}}
{{- end}}
#
# The sources are the Linux release archives; each checksum is the SHA-256
# recorded in the release manifest. Pull request merge needs Git 2.38 or newer,
# and language settings in .gitattributes need Git 2.40 or newer.

pkgname=owngit-bin
pkgver={{sh .Version}}
pkgrel=1
pkgdesc='Private Git storage and browser dashboard on your own computer'
arch=('x86_64' 'aarch64')
url={{sh .Homepage}}
license=('MIT')
depends=('git')
provides=('owngit')
conflicts=('owngit')
# Install the release binary unchanged.
options=('!strip' '!debug')
source_x86_64=({{sh (print .BaseURL "/" .LinuxAMD64.Name)}})
sha256sums_x86_64=({{sh .LinuxAMD64.SHA256}})
source_aarch64=({{sh (print .BaseURL "/" .LinuxARM64.Name)}})
sha256sums_aarch64=({{sh .LinuxARM64.SHA256}})

package() {
  install -Dm755 owngit "$pkgdir/usr/bin/owngit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  local doc="$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 docs/CODING_TOOLS.md docs/CODING_TOOLS.ko.md -t "$doc/docs"
  install -Dm644 integrations/skills/owngit-checks/SKILL.md -t "$doc/integrations/skills/owngit-checks"
  cp -r --no-preserve=ownership THIRD_PARTY_NOTICES "$doc/"
}
